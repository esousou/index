<?xml version="1.0" encoding="UTF-8"?>
<!--
  index-z. — links live only in visitors' memory and expire after 24 hours, so
  there is no stable list of them to publish here. The root document is the
  crawlable directory: every live link is a real <a href="/?url=..."> on it, and
  the head carries matching hreflang alternates and JSON-LD at runtime.
-->
<urlset
  xmlns="http://www.sitemaps.org/schemas/sitemap/0.9"
  xmlns:xhtml="http://www.w3.org/1999/xhtml"
>
  <url>
    <loc>https://index-z.pages.dev/</loc>
    <changefreq>hourly</changefreq>
    <priority>1.0</priority>
    <xhtml:link rel="alternate" hreflang="en" href="https://index-z.pages.dev/?lang=en" />
    <xhtml:link rel="alternate" hreflang="zh" href="https://index-z.pages.dev/?lang=zh" />
    <xhtml:link rel="alternate" hreflang="ko" href="https://index-z.pages.dev/?lang=ko" />
    <xhtml:link rel="alternate" hreflang="ja" href="https://index-z.pages.dev/?lang=ja" />
    <xhtml:link rel="alternate" hreflang="es" href="https://index-z.pages.dev/?lang=es" />
    <xhtml:link rel="alternate" hreflang="fr" href="https://index-z.pages.dev/?lang=fr" />
    <xhtml:link rel="alternate" hreflang="x-default" href="https://index-z.pages.dev/" />
  </url>
</urlset>
